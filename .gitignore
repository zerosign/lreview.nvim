# git-ignore-start: vim
# Swap
[._]*.s[a-v][a-z]
# comment out the next line if you don't need vector files
!*.svg
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]

# Session
Session.vim
Sessionx.vim

# Temporary
.netrwhist
*~
# Auto-generated tag files
tags

# Luacov code coverage output files
luacov.stats.out
luacov.report.out
# Persistent undo
[._]*.un~
# git-ignore-end: vim

# git-ignore-start: lua
# Compiled Lua sources
luac.out

# luarocks build files
*.src.rock
*.zip
*.tar.gz

# Object files
*.o
*.os
*.ko
*.obj
*.elf

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo
*.def
*.exp

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex
# git-ignore-end: lua

# Local test clones of sample repos (discovery/testing only)
tmp/

# Sandbox runtime state and caches
sandbox/cache/
sandbox/state/
sandbox/data/
sandbox/config/
*.db
*.luac
*.log
session-ses_*.md

# Infigraph code graph database and caches
.infigraph/

# Claude AI agent configuration folders
.claude/
